# ==============================================================================
# DSA REVISION OS - CLOUD DEPLOYMENT ENVIRONMENT TEMPLATE
# Copy these key-value pairs into your cloud provider's Environment settings
# (Render / Railway / Fly.io / AWS ECS / Google Cloud Run / Coolify)
# ==============================================================================

# Application Port (Usually injected automatically by cloud platforms)
PORT=8080

# Cloud PostgreSQL Database Connection (e.g., Neon.tech, AWS RDS, Supabase)
# If your provider gives a single DATABASE_URL (postgres://user:pass@host/db),
# the container entrypoint will automatically sanitize it.
DB_URL=jdbc:postgresql://<neon-subdomain>.neon.tech/<database_name>?sslmode=require
DB_USERNAME=<database_user>
DB_PASSWORD=<database_password>

# Schema Management (use 'update' for initial deploy, 'validate' for strict prod)
JPA_DDL_AUTO=update

# Frontend Production Domains allowed by CORS (Comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# Cryptographically Secure JWT Secret (min 32 bytes)
JWT_SECRET=replace_with_a_secure_random_key_or_use_generated_value

# Token Expiry (24 hours in ms: 86400000)
JWT_EXPIRATION_MS=86400000
