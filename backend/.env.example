# ===================================================================
# DSA Revision Tracker Backend - Environment Variables Template
# Copy this file to .env or export these in your shell before running
# ===================================================================

# Server Port
PORT=8080

# PostgreSQL Connection Parameters
# For Cloud PostgreSQL (e.g. Neon.tech):
# DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password
#
# Local fallback parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dsa_revision
DB_USER=postgres
DB_PASSWORD=postgres

# Hibernate Schema Generation Strategy (update, validate, none)
JPA_DDL_AUTO=update

# Frontend CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Authentication Parameters
JWT_SECRET=your_super_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
